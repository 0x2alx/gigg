# Example Quadlet unit (rootless podman). Copy to ~/.config/containers/systemd/gigg.container and
# adjust. HTTPS on the main listener from certificate files; an extra plain-HTTP listener on
# loopback for local API/MCP clients (optional).
[Unit]
Description=gigg gig board

[Container]
Image=localhost/gigg:latest
ContainerName=gigg
Environment=GIGG_LISTEN=:8443 GIGG_TLS_CERT=/run/gigg/tls.crt GIGG_TLS_KEY=/run/gigg/tls.key
Environment=GIGG_PUBLIC_URL=https://board.example:8443
Environment=GIGG_LISTEN_INTERNAL=:8080 GIGG_ALLOWED_HOSTS=gigg
PublishPort=8443:8443
PublishPort=127.0.0.1:8080:8080
Volume=gigg:/data
# The certificate and key: podman secrets (podman secret create gigg_tls_cert cert.pem; ... gigg_tls_key key.pem).
# The image runs as UID 65532, which must be able to read the key.
Secret=gigg_tls_cert,type=mount,target=/run/gigg/tls.crt,mode=0444
Secret=gigg_tls_key,type=mount,target=/run/gigg/tls.key,uid=65532,mode=0400
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
# Exec form: the image has no shell, so a plain string (run via /bin/sh -c) would always fail.
HealthCmd=["/gigg","healthcheck"]
HealthInterval=30s
StopTimeout=20

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
