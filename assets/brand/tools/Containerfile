FROM docker.io/library/alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
RUN apk add --no-cache imagemagick imagemagick-svg librsvg rsvg-convert font-noto fontconfig python3 py3-pillow
# Anta (OFL-1.1), the wordmark and tagline font: the Google Fonts TTF as packaged on npm, a fixed version
# checked by sha256
ARG ANTA_TGZ=https://registry.npmjs.org/@expo-google-fonts/anta/-/anta-0.4.0.tgz
ARG ANTA_SHA256=d3180de75b227edafa99d86c51062c9586d63c4ebeffbb07a065b34cf024d0f4
RUN wget -q -O /tmp/anta.tgz "$ANTA_TGZ" \
 && echo "$ANTA_SHA256  /tmp/anta.tgz" | sha256sum -c - \
 && mkdir -p /usr/share/fonts/anta \
 && tar -xzf /tmp/anta.tgz -C /usr/share/fonts/anta --strip-components=2 package/400Regular/Anta_400Regular.ttf \
 && rm /tmp/anta.tgz && fc-cache -f && fc-list | grep -i anta
