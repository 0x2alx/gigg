FROM docker.io/library/alpine:3.20
RUN apk add --no-cache imagemagick imagemagick-svg librsvg rsvg-convert font-noto fontconfig python3 py3-pillow
RUN mkdir -p /usr/share/fonts/poppins && wget -q -O /usr/share/fonts/poppins/Poppins-Bold.ttf https://github.com/google/fonts/raw/main/ofl/poppins/Poppins-Bold.ttf && wget -q -O /usr/share/fonts/poppins/Poppins-Medium.ttf https://github.com/google/fonts/raw/main/ofl/poppins/Poppins-Medium.ttf && fc-cache -f && fc-list | grep -i poppins
