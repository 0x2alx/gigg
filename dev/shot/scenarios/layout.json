{
  "base": "https://gigg-dev:8443",
  "viewport": [2000, 900],
  "steps": [
    {"goto": "/"},
    {"wait": "input[autocomplete=username]"},
    {"type": ["input[autocomplete=username]", "ada"]},
    {"type": ["input[autocomplete=current-password]", "gigg-dev-password"]},
    {"press": "Enter"},
    {"wait": ".board"},
    {"eval": "document.querySelector('.shell.collapsed') && document.querySelector('.collapse').click(), true", "expect": true},
    {"goto": "/admin"},
    {"wait": ".admin-home"},
    {"eval": "document.documentElement.style.fontSize = '90%', true", "expect": true},
    {"eval": "document.querySelectorAll('.admin-tabs').length", "expect": 0},
    {"eval": "document.querySelectorAll('.nav-sub .nav-item').length", "expect": 5},
    {"eval": "Math.round(document.querySelector('.content').getBoundingClientRect().right - document.querySelector('.admin-home').getBoundingClientRect().right) < 40", "expect": true},
    {"shot": "admin-90"},
    {"click": ".nav-sub a[href='/admin/users']"},
    {"wait": ".admin-table-card"},
    {"eval": "document.documentElement.style.fontSize = '90%', document.querySelector('.nav-sub a[aria-current=page]').textContent.trim()", "expect": "☺Users"},
    {"shot": "admin-users-90"},
    {"goto": "/profile"},
    {"wait": ".profile"},
    {"eval": "document.documentElement.style.fontSize = '90%'; const c = document.querySelector('.content').getBoundingClientRect(), p = document.querySelector('.profile').getBoundingClientRect(); Math.abs((p.left - c.left) - (c.right - p.right)) < 30", "expect": true},
    {"shot": "profile-90"},
    {"goto": "/my"},
    {"wait": 800},
    {"eval": "document.documentElement.scrollWidth <= document.documentElement.clientWidth", "expect": true},
    {"shot": "my-tasks"},
    {"goto": "/"},
    {"wait": ".board"},
    {"click": ".page-head a.button"},
    {"wait": "table"},
    {"eval": "document.documentElement.scrollWidth <= document.documentElement.clientWidth", "expect": true},
    {"shot": "table"},
    {"eval": "window.dispatchEvent(new KeyboardEvent('keydown', {key: 'k', ctrlKey: true})), true", "expect": true},
    {"wait": 300},
    {"eval": "!!document.querySelector('[role=combobox]')", "expect": true},
    {"shot": "palette"}
  ]
}
