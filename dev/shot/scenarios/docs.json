{
 "base": "https://gigg-demo:8443",
 "viewport": [
  1440,
  900
 ],
 "waitUntil": "domcontentloaded",
 "steps": [
  {
   "goto": "/"
  },
  {
   "wait": "input[autocomplete=username]"
  },
  {
   "type": [
    "input[autocomplete=username]",
    "dana"
   ]
  },
  {
   "type": [
    "input[autocomplete=current-password]",
    "demo-password-2026"
   ]
  },
  {
   "press": "Enter"
  },
  {
   "wait": ".board"
  },
  {
   "wait": 6000
  },
  {
   "eval": "(() => { fetch('/api/v1/me', { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ preferences: { board_filters: null, board_filter: null } }) }); return true; })()",
   "expect": true
  },
  {
   "wait": 800
  },
  {
   "eval": "(async () => { const r = await fetch('/api/v1/me/themes-selection', { method: 'PUT', headers: {'Content-Type': 'application/json', 'X-Gigg-CSRF': '1'}, body: JSON.stringify({ selected_id: 'nightwalker', match_system: false }) }); return r.status; })()",
   "expect": 204
  },
  {
   "goto": "/board"
  },
  {
   "wait": ".board .gig-card"
  },
  {
   "wait": 1800
  },
  {
   "wait": ".live-dot.live-live"
  },
  {
   "wait": 300
  },
  {
   "shot": "board-all-night",
   "full": false
  },
  {
   "hover": ".gig-card .run-badge"
  },
  {
   "wait": 800
  },
  {
   "shot": "tooltip-night",
   "full": false
  },
  {
   "goto": "/board?p=1"
  },
  {
   "wait": ".board .gig-card"
  },
  {
   "eval": "(() => { const b = [...document.querySelectorAll(\".appbar a\")].find(x => x.textContent.includes(\"New gig\")); if (!b) return false; b.click(); return true; })()",
   "expect": true
  },
  {
   "wait": "[role=dialog] input"
  },
  {
   "type": [
    "[role=dialog] input",
    "Rotate the API signing keys"
   ]
  },
  {
   "wait": 500
  },
  {
   "shot": "gig-new-night",
   "full": false
  },
  {
   "goto": "/board?p=3&tool=recurring"
  },
  {
   "wait": "[role=dialog] .rec-row, [role=dialog] li, [role=dialog] article"
  },
  {
   "wait": 700
  },
  {
   "shot": "recurring-night",
   "el": "[role=dialog]"
  },
  {
   "goto": "/dashboard"
  },
  {
   "wait": ".dash-card"
  },
  {
   "wait": 1800
  },
  {
   "wait": ".live-dot.live-live"
  },
  {
   "wait": 300
  },
  {
   "shot": "dashboard-night",
   "full": false
  },
  {
   "goto": "/board"
  },
  {
   "wait": ".board"
  },
  {
   "eval": "(() => { window.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', ctrlKey: true, bubbles: true })); return true; })()",
   "expect": true
  },
  {
   "wait": "input[aria-label=Command]"
  },
  {
   "type": [
    "input[aria-label=Command]",
    "rate"
   ]
  },
  {
   "wait": 700
  },
  {
   "shot": "palette-night",
   "full": false
  },
  {
   "goto": "/profile"
  },
  {
   "wait": ".profile"
  },
  {
   "wait": 1800
  },
  {
   "wait": ".live-dot.live-live"
  },
  {
   "wait": 300
