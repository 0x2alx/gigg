  {
   "eval": "(() => { document.querySelector(\"section[aria-label='Agent run']\").scrollIntoView({ block: 'center', behavior: 'instant' }); return true; })()",
   "expect": true
  },
  {
   "wait": 400
  },
  {
   "shot": "agent-run-day",
   "el": "section[aria-label='Agent run']",
   "margin": 8
  },
  {
   "goto": "/inbox"
  },
  {
   "wait": ".inbox"
  },
  {
   "wait": 1800
  },
  {
   "wait": ".live-dot.live-live"
  },
  {
   "wait": 300
  },
  {
   "shot": "inbox-day",
   "full": false
  },
  {
   "goto": "/table"
  },
  {
   "wait": "table"
  },
  {
   "wait": 1800
  },
  {
   "wait": ".live-dot.live-live"
  },
  {
   "wait": 300
  },
  {
   "shot": "table-day",
   "full": false
  },
  {
   "goto": "/themes"
  },
  {
   "wait": "h1"
  },
  {
   "wait": 1800
  },
  {
   "wait": ".live-dot.live-live"
  },
  {
   "wait": 300
  },
  {
   "shot": "themes-day",
   "full": false
  },
  {
   "goto": "/admin/users"
  },
  {
   "wait": "table"
  },
  {
   "eval": "(() => { const row = [...document.querySelectorAll('tr')].find(r => r.textContent.includes('Sam Okafor')); const b = row && [...row.querySelectorAll('button')].find(x => x.textContent.includes('Permissions')); if (!b) return false; b.click(); return true; })()",
   "expect": true
  },
  {
   "wait": "[role=dialog]"
  },
  {
   "wait": 900
  },
  {
   "eval": "(() => { const b = [...document.querySelectorAll(\"[role=dialog] button\")].find(x => x.textContent.includes(\"Acme Ops\")); if (!b) return false; b.click(); return true; })()",
   "expect": true
  },
  {
   "wait": 700
  },
  {
   "shot": "admin-permissions-day",
   "full": false
  },
  {
   "goto": "/admin/keys"
  },
  {
   "wait": "h1"
  },
  {
   "wait": 1800
  },
  {
   "eval": "(() => { const w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT); for (let n = w.nextNode(); n; n = w.nextNode()) n.nodeValue = n.nodeValue.replace(/\\b(10|172|192)\\.\\d+\\.\\d+\\.\\d+\\b/g, '192.0.2.10'); return true; })()",
   "expect": true
  },
  {
   "shot": "admin-keys-day",
   "full": false
  },
  {
   "goto": "/board?tool=trash"
  },
  {
   "wait": ".trash-item"
  },
  {
   "wait": 600
  },
  {
   "shot": "trash-day",
   "el": "[role=dialog]"
  },
  {
   "viewport": [
    390,
    844
   ]
  },
  {
   "goto": "/board"
  },
  {
   "wait": ".board"
  },
  {
   "wait": 1800
  },
  {
   "wait": ".live-dot.live-live"
  },
  {
   "wait": 300
  },
  {
   "shot": "board-mobile-day",
   "full": false
  },
  {
   "viewport": [
    1440,
    900
   ]
  },
  {
   "eval": "(async () => { const r = await fetch('/api/v1/me/themes-selection', { method: 'PUT', headers: {'Content-Type': 'application/json', 'X-Gigg-CSRF': '1'}, body: JSON.stringify({ selected_id: 'nightwalker', match_system: false }) }); return r.status; })()",
   "expect": 204
  }
 ]
