  {
   "wait": ".help-body"
  },
  {
   "wait": 900
  },
  {
   "shot": "help-night",
   "full": false
  },
  {
   "eval": "(async () => { const r = await fetch('/api/v1/me/themes-selection', { method: 'PUT', headers: {'Content-Type': 'application/json', 'X-Gigg-CSRF': '1'}, body: JSON.stringify({ selected_id: 'daywalker', match_system: false }) }); return r.status; })()",
   "expect": 204
  },
  {
   "eval": "(() => { fetch('/api/v1/me', { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ preferences: { board_filters: 'open' } }) }); return true; })()",
   "expect": true
  },
  {
   "wait": 800
  },
  {
   "goto": "/board?ws=acme&pr=2"
  },
  {
   "wait": ".board .gig-card"
  },
  {
   "wait": 1800
  },
  {
   "wait": ".live-dot.live-live"
  },
  {
   "wait": 300
