  {
   "wait": "aside.panel .tp-body"
  },
  {
   "wait": 1200
  },
  {
   "wait": ".live-dot.live-live"
  },
  {
   "wait": 300
  },
  {
   "shot": "gig-panel-day",
   "full": false
  },
  {
   "goto": "/board/p/1/g/PLT-4"
  },
  {
   "wait": "section[aria-label='Agent run']"
  },
  {
   "wait": 1500
