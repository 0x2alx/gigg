  },
  {
   "eval": "document.querySelector('.wp-button .wp-face').textContent",
   "expect": "Where: Scripts"
  },
  {
   "eval": "(l => [l.querySelector('input').checked, l.querySelector('input').disabled])([...document.querySelectorAll('.wp-row')].find(l => l.textContent.trim() === 'Billing'))",
   "expect": [
    false,
    false
   ]
  },
  {
   "wait": 800
  },
  {
   "eval": "['atlas/main', 'atlas/billing', 'meridian/scripts', 'meridian/main'].map(k => document.querySelector('.board').textContent.includes('Where ' + k))",
   "expect": [
    false,
    false,
    true,
    false
   ]
  },
  {
   "click": ".wp-all"
  },
  {
   "eval": "document.querySelector('.wp-button .wp-face').textContent",
   "expect": "Where: All"
  },
  {
   "press": "Escape"
  },
  {
   "eval": "document.documentElement.scrollWidth <= document.documentElement.clientWidth",
   "expect": true
