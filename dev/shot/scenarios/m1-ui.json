{
  "base": "https://gigg-dev:8443",
  "viewport": [1440, 900],
  "steps": [
    {"goto": "/"},
    {"wait": "input[autocomplete=username]"},
    {"type": ["input[autocomplete=username]", "ada"]},
    {"type": ["input[autocomplete=current-password]", "gigg-dev-password"]},
    {"press": "Enter"},
    {"wait": ".board"},
    {"eval": "document.querySelectorAll('.column').length", "expect": 5},
    {"eval": "document.documentElement.scrollWidth <= document.documentElement.clientWidth", "expect": true},
    {"click": ".page-head button.button:not(.secondary)"},
    {"wait": "form[aria-label='New task']"},
    {"type": ["form[aria-label='New task'] input", "Scenario task"]},
    {"click": "form[aria-label='New task'] button[type=submit]"},
    {"wait": 500},
    {"eval": "[...document.querySelectorAll('.card-title')].some(e => e.textContent === 'Scenario task')", "expect": true},
    {"shot": "board"},
    {"goto": "/inbox"},
    {"wait": ".inbox"},
    {"shot": "inbox"},
    {"viewport": [1024, 768]},
    {"goto": "/"},
    {"wait": ".board"},
    {"eval": "document.documentElement.scrollWidth <= document.documentElement.clientWidth", "expect": true},
    {"shot": "board-1024"}
  ]
}
